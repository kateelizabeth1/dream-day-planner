def build_day(energy, vibe, setting, flavor, group, budget, decade):
    values = [energy, vibe, setting, flavor, group, budget, decade]
    if any(value is None or value == "" for value in values):
        return """
        <div style="font-family:sans-serif;padding:16px;border-radius:12px;
                    background:#ffe8e8;color:#222">
          Please answer every question first. 🙂
        </div>"""

    answers = {
        "energy": energy,
        "vibe": vibe,
        "setting": setting,
        "flavor": flavor,
        "group": group,
        "budget": budget,
        "decade": decade,
    }

    food = pick(FOODS, answers)
    activity = pick(ACTIVITIES, answers)
    decade_songs = [song for song in SONGS if song["decade"] == decade] or SONGS
    song = pick(decade_songs, answers)
    twist = pick_twist(TWISTS, answers, activity["name"])

    return render_day_card(energy, vibe, group, food, activity, song, twist)


def render_day_card(energy, vibe, group, food, activity, song, twist):
