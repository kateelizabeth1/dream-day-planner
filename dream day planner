    accent_color = theme["accent"]
    escaped = html.escape

    return f"""
    <div style="font-family:Arial,sans-serif;max-width:520px;margin:10px auto;
                padding:24px;border-radius:20px;background:{bg_color};color:#222;
                box-shadow:0 4px 14px rgba(0,0,0,0.12)">

