def day_as_text(title, food, act, song, twist, why):
    return (
        f"{title}\n\n"
        f"Food: {food['name']}\n"
        f"Activity: {act['name']}\n"
        f"Song: {song['title']} by {song['artist']}\n"
        f"Surprise twist: {twist['name']}\n\n"
        f"{why}"
    )


def save_text(text, path="/content/my_dream_day.txt"):
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    return path

